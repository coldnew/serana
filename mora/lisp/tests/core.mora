;;; tests/core.mora --- Comprehensive tests for mora lisp core language

(defn t [result expr-str] (is-expr result expr-str))

(register-test "test-addition"
  (fn [] (t (= 3 (+ 1 2)) "(+ 1 2)") (t (= 10 (+ 1 2 3 4)) "(+ 4)")))

(register-test "test-subtraction"
  (fn [] (t (= -1 (- 1 2)) "(-)") (t (= 0 (- 5 5)) "(- zero)")))

(register-test "test-multiplication"
  (fn [] (t (= 6 (* 2 3)) "(* 2 3)") (t (= 24 (* 2 3 4)) "(* 4)")))

(register-test "test-division"
  (fn [] (t (= 2 (/ 6 3)) "(/ int)") (t (= 2.5 (/ 5.0 2.0)) "(/ float)")))

(register-test "test-inc-dec"
  (fn [] (t (= 2 (inc 1)) "(inc)") (t (= 0 (dec 1)) "(dec)")))

(register-test "test-min-max"
  (fn [] (t (= 1 (min 1 2 3)) "(min)") (t (= 3 (max 1 2 3)) "(max)")))

(register-test "test-equality"
  (fn []
    (t (= 1 1) "(= int)") (t (= "abc" "abc") "(= str)")
    (t (= true true) "(= bool)") (t (= nil nil) "(= nil)")
    (t (= :kw :kw) "(= kw)") (t (not (= 1 2)) "(not =)")))

(register-test "test-comparison"
  (fn [] (t (< 1 2) "(<)") (t (> 2 1) "(>)") (t (<= 1 1) "(<=)") (t (>= 2 2) "(>=)")))

(register-test "test-logic"
  (fn []
    (t (= true (not false)) "(not)") (t (= 2 (and 1 2)) "(and)")
    (t (= 1 (or 1 2)) "(or)") (t (= 2 (or nil 2)) "(or nil)")))

(register-test "test-type-predicates"
  (fn []
    (t (nil? nil) "(nil?)") (t (int? 42) "(int?)") (t (float? 3.14) "(float?)")
    (t (number? 42) "(number?)") (t (string? "hello") "(string?)") (t (keyword? :foo) "(keyword?)")))

(register-test "test-list-operations"
  (fn []
    (t (= 3 (count '(1 2 3))) "(count)") (t (= 1 (first '(1 2 3))) "(first)")
    (t (= 3 (last '(1 2 3))) "(last)") (t (= '(2 3) (rest '(1 2 3))) "(rest)")
    (t (= '(0 1 2 3) (cons 0 '(1 2 3))) "(cons)")))

(register-test "test-vector-operations"
  (fn []
    (t (= 3 (count [1 2 3])) "(count)") (t (= [1 2 3 4] (conj [1 2 3] 4)) "(conj)")
    (t (= 2 (nth [0 1 2 3] 2)) "(nth)")))

(register-test "test-map-operations"
  (fn []
    (t (= 1 (get {:a 1 :b 2} :a)) "(get)") (t (= nil (get {:a 1} :c)) "(get miss)")
    (t (= 99 (get {:a 1} :c 99)) "(get default)")
    (t (= {:a 1 :b 2 :c 3} (assoc {:a 1} :b 2 :c 3)) "(assoc)")
    (t (= {:a 1} (dissoc {:a 1 :b 2} :b)) "(dissoc)")
    (t (contains? {:a 1} :a) "(contains?)")))

(register-test "test-seq-operations"
  (fn []
    (t (= '(1 2 3 4 5) (concat '(1 2) '(3 4 5))) "(concat)")
    (t (= '(1 2 3) (take 3 '(1 2 3 4 5))) "(take)")
    (t (= '(4 5) (drop 3 '(1 2 3 4 5))) "(drop)")
    (t (= '(2 4) (filter even? '(1 2 3 4 5))) "(filter)")
    (t (= '(2 4 6) (map inc '(1 3 5))) "(map)")
    (t (= 15 (reduce + 0 '(1 2 3 4 5))) "(reduce)")
    (t (= '(1 2 3) (sort '(3 1 2))) "(sort)")
    (t (= '(3 2 1) (reverse '(1 2 3))) "(reverse)")))

(register-test "test-empty-predicate"
  (fn [] (t (empty? '()) "(empty? list)") (t (empty? []) "(empty? vec)")
    (t (not (empty? '(1))) "(not empty?)")))

(register-test "test-higher-order-fns"
  (fn []
    (t (= '(2 3 4) (map inc '(1 2 3))) "(map)")
    (t (= '(2 4) (filter even? '(1 2 3 4))) "(filter)")
    (t (= true (some even? '(1 2 3))) "(some)")
    (t (= true (every? number? '(1 2 3))) "(every?)")))

(register-test "test-let-bindings"
  (fn []
    (t (= 10 (let [x 5 y (* x 2)] y)) "(let)")
    (t (= 42 (let [x 6] (let [y 7] (* x y)))) "(nested let)")))

(register-test "test-conditionals"
  (fn []
    (t (= "yes" (if true "yes" "no")) "(if true)")
    (t (= "no" (if false "yes" "no")) "(if false)")
    (t (= 42 (when true 42)) "(when)")
    (t (= "b" (cond false "a" true "b")) "(cond)")))

(register-test "test-loop-recur"
  (fn []
    (t (= 10 (loop [i 0] (if (>= i 10) i (recur (inc i))))) "(loop)")
    (t (= 55 (loop [i 1 s 0] (if (> i 10) s (recur (inc i) (+ s i))))) "(loop sum)")))

(register-test "test-atoms"
  (fn []
    (let [a (atom 10)]
      (t (= 10 @a) "(atom)") (reset! a 20) (t (= 20 @a) "(reset!)")
      (swap! a inc) (t (= 21 @a) "(swap! inc)") (swap! a + 5) (t (= 26 @a) "(swap! +)"))))

(register-test "test-strings"
  (fn []
    (t (= 5 (count "hello")) "(count)") (t (= "hello world" (str "hello" " " "world")) "(str)")
    (t (= "42" (str 42)) "(str int)") (t (= "" (str nil)) "(str nil)")))

(register-test "test-keywords"
  (fn []
    (t (= :foo :foo) "(kw eq)") (t (not (= :foo :bar)) "(kw neq)")
    (t (= "foo" (name :foo)) "(name)") (t (= :foo (keyword "foo")) "(keyword)")))

(register-test "test-threading-macros"
  (fn [] (t (= 6 (-> 1 (+ 2) (* 2))) "(->)") (t (= 7 (->> 1 (+ 2) (+ 4))) "(->>)")))

(register-test "test-async-basic"
  (fn [] (t (= 42 (await (async 42))) "(async await)")))

(register-test "test-async-env-capture"
  (fn [] (let [x 10] (t (= 15 (await (async (+ x 5)))) "(async env)"))))

(register-test "test-await-future"
  (fn [] (t (= 99 (await (future 99))) "(await future)")))

(register-test "test-await-promise"
  (fn [] (let [p (promise)] (deliver p 77) (t (= 77 (await p)) "(await promise)"))))

(register-test "test-await-all"
  (fn []
    (let [a (async 1) b (async 2) c (async 3)]
      (let [r (await-all a b c)]
        (t (= 3 (count r)) "(await-all count)")
        (t (= 1 (nth r 0)) "(await-all 0)") (t (= 2 (nth r 1)) "(await-all 1)")
        (t (= 3 (nth r 2)) "(await-all 2)")))))

(register-test "test-async-parallel"
  (fn [] (let [a (async (+ 10 20)) b (async (* 3 4))]
    (t (= 42 (+ (await a) (await b))) "(parallel)"))))

(register-test "test-misc"
  (fn []
    (t (= 42 (identity 42)) "(identity)") (t (= nil (identity nil)) "(identity nil)")
    (t (= nil (first '())) "(first empty)") (t (= '() (rest '())) "(rest empty)")
    (t (= true (empty? nil)) "(empty? nil)")))
