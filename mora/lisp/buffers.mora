;;; buffers.mora --- Mora Lisp buffer commands

(ns mora.buffers)
(require [mora.buffer :as buffer])
(require [mora.editor :as editor])
(require [mora.minibuffer :as minibuffer])

(defcommand list-buffers
  "List buffers in the echo area."
  []
  (editor/message (str "Buffers: " (buffer/buffer-list))))
